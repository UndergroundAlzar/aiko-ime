{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiko.local/live2d/contracts/expression3.schema.json",
  "title": "Aiko Cubism expression3 contract",
  "type": "object",
  "required": [
    "Type",
    "Parameters"
  ],
  "properties": {
    "Type": {
      "const": "Live2D Expression"
    },
    "FadeInTime": {
      "type": "number",
      "minimum": 0
    },
    "FadeOutTime": {
      "type": "number",
      "minimum": 0
    },
    "Parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "Id",
          "Value",
          "Blend"
        ],
        "properties": {
          "Id": {
            "type": "string",
            "minLength": 1
          },
          "Value": {
            "type": "number"
          },
          "Blend": {
            "enum": [
              "Add",
              "Multiply",
              "Overwrite"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
